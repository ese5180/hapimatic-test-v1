#include <zephyr/dt-bindings/pwm/pwm.h>

/*
 * PA0 is shared with user button B1 on this board. It is used here as the
 * TIM2_CH1 PWM output, so the button is removed from devicetree to keep any
 * driver (e.g. gpio-keys with CONFIG_INPUT) from claiming the pin.
 * Do not press B1 while the output is running: it shorts PA0 to GND.
 */
/ {
	aliases {
		/delete-property/ sw0;
	};

	zephyr,user {
		/* TIM2 channel 1 on PA0: 20 kHz, 50 % duty set in main.c */
		pwms = <&pwm2 1 PWM_KHZ(20) PWM_POLARITY_NORMAL>;
	};
};

/delete-node/ &user_button_1;

&timers2 {
	status = "okay";
	/* 48 MHz timer clock, no prescaler: 20 kHz period = 2400 counts */
	st,prescaler = <0>;

	pwm2: pwm {
		status = "okay";
		pinctrl-0 = <&tim2_ch1_pa0>;
		pinctrl-names = "default";
	};
};
