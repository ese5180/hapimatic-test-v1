/ {
	aliases {
		accel0 = &adxl343;
	};
};

/*
 * Power: run SYSCLK straight from the 16 MHz HSI with the PLL off (board
 * default is HSI -> PLL at 48 MHz). Peripheral timings (I2C2, LPUART1) and
 * flash wait states are derived from the clock tree by Zephyr.
 */
&pll {
	status = "disabled";
};

&rcc {
	clocks = <&clk_hsi>;
	clock-frequency = <DT_FREQ_M(16)>;
};

/*
 * Power: limit idle to Stop0/Stop1. Measured on this board, Stop2 puts a
 * ~32 kHz signal on PA2 (LPUART1 TX, the ST-LINK console: decoded as a
 * stream of '6') and draws more than Stop1 (54 vs 19 uA median).
 */
&stop2 {
	status = "disabled";
};

/*
 * ADXL343 accelerometer on the Arduino-header I2C bus (I2C2, 400 kHz):
 * SDA = D14 (PA11), SCL = D15 (PA12). SDO/ALT ADDRESS low selects 0x53.
 */
&arduino_i2c {
	adxl343: adxl343@53 {
		compatible = "adi,adxl343";
		reg = <0x53>;
		range = <2>;
		odr = <100>;
	};
};
